# Copy this file to .env.local and fill in the values.
# cp .env.example .env.local
# Restart `npm run dev` after any change.
# Never commit .env.local. Never prefix a secret with NEXT_PUBLIC_.

# --- Supabase ---
# Project URL from Connect, or from Project Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Browser key. Use the publishable key (sb_publishable_...) or the legacy anon key.
# Set only one of the two lines below.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Secret key (sb_secret_...) or the legacy service_role key.
# Needed to create student accounts and save guest admission forms.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider ---
# ollama or gemini. Only the matching block below is used.
AI_PROVIDER=ollama

# --- Ollama (local). No API key. Ollama must already be running. ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Gemini. Used when AI_PROVIDER=gemini. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Pinecone. Same index for either AI provider. ---
# The index must embed the field named chunk_text. See README.
PINECONE_API_KEY=
PINECONE_INDEX=
